---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { Image } from 'astro:assets';

const images_glob = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/art/*.{jpeg,jpg,png,gif}', {eager: true});
const images = await Promise.all(
  Object.entries(images_glob).map(async ([_, img]) => getImage({ src: img.default, format: 'jpeg'}))
)
---

<style>

.hscroll__container {
  display: flex;
  align-items: flex-end;  
  width: fit-content;  
  padding: 0 2rem;
}

.hscroll__card {
  width: 300px;
  height: fit-content;
  margin-right: 2rem;

  & img {
    width: 100%;
    object-fit: contain;
    display: block;
  }
}

</style>

<div class="hscroll__container">  

  <div class="hscroll__card">    
    <img src={images[0].src} loading="lazy"/>
    <p>Gyroid254</p>
  </div>

  <div class="hscroll__card">    
    <img src={images[1].src} loading="lazy"/>
    <p>Pills</p>
  </div>

  <div class="hscroll__card">    
    <img src={images[2].src} loading="lazy"/>
    <p>NoroN</p>
  </div>

  <div class="hscroll__card">    
    <img src={images[3].src} loading="lazy"/>
    <p>Eyelid</p>
  </div>

  <div class="hscroll__card">    
    <img src={images[4].src} loading="lazy"/>
    <p>Shwarz</p>
  </div>

  <div class="hscroll__card">    
    <img src={images[5].src} loading="lazy"/>
    <p>Pool</p>
  </div>

  <div class="hscroll__card">    
    <img src={images[6].src} loading="lazy"/>
    <p>enerGYRing</p>
  </div>

  <div class="hscroll__card">    
    <img src={images[7].src} loading="lazy"/>
    <p>Toru</p>
  </div>

</div>