---
import Layout from '../layouts/Layout.astro';
import imgKGLW from '../assets/images/kglw_white_transparent.gif';
import Marquee from '../components/Marquee.astro';
import AboutCard from '../components/AboutCard.astro';
import HorizontalScroll from '../components/HorizontalScroll.astro';
---

<Layout>		
	<canvas id="webgl"></canvas>
	<section id="header-sticky-wrapper" class="header">
		<div id="header" class="cover">
			<Marquee text="I hate Java" separator="☠" />
			<nav class="cover__nav">
				<ul>
					<li><a href="#">Home</a></li>
					<li><a href="#">About</a></li>
					<li><a href="#">Art</a></li>
					<li><a href="#">Blog</a></li>
					<li><a href="#">CV</a></li>
				</ul>
			</nav>
			
			<div class="cover__content">
				<div id="logotext">
					<h2 style="font-size: clamp(1.8rem, 6vw + 1rem, 6rem); color: transparent;">DARKENSSES</h2>
				</div>
			</div>

			<div class="cover__info">
				<div class="cover__info-block">
					<div class="cover__info-title">
						<span>Social media</span>
					</div>
					<div class="cover__info-content">
						<a href="https://x.com/Darkensses" target="_blank" rel="noopener noreferrer">x</a>
						<a href="https://www.instagram.com/darkensses" target="_blank" rel="noopener noreferrer">instagram</a>
						<a href="https://github.com/Darkensses" target="_blank" rel="noopener noreferrer">github</a>
						<a href="https://www.linkedin.com/in/jasielguillen" target="_blank" rel="noopener noreferrer">linkedin</a>
					</div>
				</div>
			</div>

		</div>
	</section>

	<section id="scroll-separator">
		<div class="intro">
			
			<div class="intro__model">

				<div class="bracketbox">
					<div class="bracketbox__container">
						<div id="model-box"></div>
					</div>
					<div class="bracketbox__info">
						<span>psx_we2002_model.glb</span>
						<span>&blk14;&blk14;&blk14;</span>
						<span>x: 10</span>						
						<span>y: 10</span>
						<span>z: 6e2</span>
					</div>
				</div>
			
			</div>

			
					<div class="lyrics__header">
						<div class="lyrics--small">
							<span>
								I seep into power sockets and travel along
								the wires	at the speed of light across
								vast electrical networks<br>
								I am electric :: I am on fire :: This is sex
							</span>
						</div>
						<div class="lyrics__header__gif">
							<img src={imgKGLW.src} />
							<div class="lyrics__gif--overlay"></div>
						</div>
					</div>

					<div class="lyrics--large">
						<div>
							<svg width="100%" height="40" viewBox="0 0 680 40" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMinYMid meet" id="main-svg"><polygon points="0,40 20,40 60,0 40,0" fill="#0000ff" opacity="1"></polygon><polygon points="29.523809523809526,40 49.523809523809526,40 89.52380952380952,0 69.52380952380952,0" fill="#0000ff" opacity="1"></polygon><polygon points="59.04761904761905,40 79.04761904761905,40 119.04761904761905,0 99.04761904761905,0" fill="#0000ff" opacity="1"></polygon><polygon points="88.57142857142858,40 108.57142857142858,40 148.57142857142858,0 128.57142857142858,0" fill="#0000ff" opacity="1"></polygon><polygon points="118.0952380952381,40 138.0952380952381,40 178.0952380952381,0 158.0952380952381,0" fill="#0000ff" opacity="1"></polygon><polygon points="147.61904761904762,40 167.61904761904762,40 207.61904761904762,0 187.61904761904762,0" fill="#0000ff" opacity="1"></polygon><polygon points="177.14285714285717,40 197.14285714285717,40 237.14285714285717,0 217.14285714285717,0" fill="#0000ff" opacity="1"></polygon><polygon points="206.66666666666669,40 226.66666666666669,40 266.6666666666667,0 246.66666666666669,0" fill="#0000ff" opacity="1"></polygon><polygon points="236.1904761904762,40 256.1904761904762,40 296.1904761904762,0 276.1904761904762,0" fill="#0000ff" opacity="1"></polygon><polygon points="265.7142857142857,40 285.7142857142857,40 325.7142857142857,0 305.7142857142857,0" fill="#0000ff" opacity="1"></polygon><polygon points="295.23809523809524,40 315.23809523809524,40 355.23809523809524,0 335.23809523809524,0" fill="#0000ff" opacity="1"></polygon><polygon points="324.76190476190476,40 344.76190476190476,40 384.76190476190476,0 364.76190476190476,0" fill="#0000ff" opacity="1"></polygon><polygon points="354.28571428571433,40 374.28571428571433,40 414.28571428571433,0 394.28571428571433,0" fill="#0000ff" opacity="1"></polygon><polygon points="383.80952380952385,40 403.80952380952385,40 443.80952380952385,0 423.80952380952385,0" fill="#0000ff" opacity="1"></polygon><polygon points="413.33333333333337,40 433.33333333333337,40 473.33333333333337,0 453.33333333333337,0" fill="#0000ff" opacity="1"></polygon><polygon points="442.8571428571429,40 462.8571428571429,40 502.8571428571429,0 482.8571428571429,0" fill="#0000ff" opacity="1"></polygon><polygon points="472.3809523809524,40 492.3809523809524,40 532.3809523809524,0 512.3809523809524,0" fill="#0000ff" opacity="1"></polygon><polygon points="501.9047619047619,40 521.9047619047619,40 561.9047619047619,0 541.9047619047619,0" fill="#0000ff" opacity="1"></polygon><polygon points="531.4285714285714,40 551.4285714285714,40 591.4285714285714,0 571.4285714285714,0" fill="#0000ff" opacity="1"></polygon><polygon points="560.952380952381,40 580.952380952381,40 620.952380952381,0 600.952380952381,0" fill="#0000ff" opacity="1"></polygon><polygon points="590.4761904761905,40 610.4761904761905,40 650.4761904761905,0 630.4761904761905,0" fill="#0000ff" opacity="1"></polygon><polygon points="620,40 640,40 680,0 660,0" fill="#0000ff" opacity="1"></polygon></svg>
						</div>
						<div class="lyrics__text">
							<span>
								I'M EVERY ONE<br>
								AND EVERY ZERO
							</span>
						</div>
					</div>

					<div class="lyrics__data">
						<span>
							Murder of the Universe :: King Gizzard & The Lizard Wizard :: [2017]
						</span>
					</div>
			

		</div>
	</section>

	<section id="about" class="wrapper-center">
		<AboutCard />
	</section>

	<secction id="art">
		<h3>Art</h3>
		<HorizontalScroll/>
	</secction>

	<section style="height: 50vh;"></section>

	<script>
		import '../scripts/scene.oop'
	</script>
</Layout>
