---
import Layout from '../layouts/Layout.astro';
import imgKGLW from '../assets/images/kglw_white_transparent.gif';
import machinerylogo from '../assets/images/virginmary.webp';
import Marquee from '../components/Marquee.astro';
import AboutCard from '../components/AboutCard.astro';
import HorizontalScroll from '../components/HorizontalScroll.astro';
---

<Layout>		
	<canvas id="webgl"></canvas>
	<section id="header-sticky-wrapper" class="header">
		<div id="header" class="cover">
			<Marquee text="I hate Java" separator="☠" />
			<nav class="cover__nav">
				<ul>
					<li><a href="#">Home</a></li>
					<li><a href="#">About</a></li>
					<li><a href="#">Art</a></li>
					<li><a href="#">Blog</a></li>
					<li><a href="#">CV</a></li>
				</ul>
			</nav>
			
			<div class="cover__content">
				<div id="logotext">
					<h2 style="font-size: clamp(1.8rem, 6vw + 1rem, 6rem); color: transparent;">DARKENSSES</h2>
				</div>
			</div>

			<div class="cover__info">
				<div class="cover__info-block">
					<div class="cover__info-title">
						<span>Social media</span>
					</div>
					<div class="cover__info-content">
						<a href="https://x.com/Darkensses" target="_blank" rel="noopener noreferrer">x</a>
						<a href="https://www.instagram.com/darkensses" target="_blank" rel="noopener noreferrer">instagram</a>
						<a href="https://github.com/Darkensses" target="_blank" rel="noopener noreferrer">github</a>
						<a href="https://www.linkedin.com/in/jasielguillen" target="_blank" rel="noopener noreferrer">linkedin</a>
					</div>
				</div>
			</div>

		</div>
	</section>

	<section id="about" class="wrapper-center">
		<AboutCard />
	</section>

	<section id="scroll-separator">

		<div class="divine">
			<Marquee text="Get Blessed" separator="&#10014;" />			
			<div class="divine__text">
				<span>Divine Machinery</span>
			</div>
			<div class="machinery">				
			</div>			

			<canvas id="asciigrid"></canvas>

			<div class="machinery__logo">
				<img src={machinerylogo.src} id="asciiImg"/>
			</div>
		</div>
	</section>


	<secction id="art">
		<h3>Art</h3>
		<HorizontalScroll/>
	</secction>

	<section style="height: 50vh;"></section>

	<script>
		import '../scripts/lenis'
		import '../scripts/scene.oop'
		import '../scripts/asciigrid.js'
	</script>
</Layout>
